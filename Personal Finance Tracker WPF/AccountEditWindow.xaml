<Window x:Class="Personal_Finance_Tracker_WPF.AccountEditWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Personal_Finance_Tracker_WPF"
        mc:Ignorable="d"
        Title="AccountEditWindow" Height="450" Width="450">
    <Grid>
        <StackPanel Margin="15">
            <TextBlock Text="Accounts"/>
            <ListBox x:Name="AccountsList" ItemsSource="{Binding WorkingAccounts}"
                 DisplayMemberPath="Name" Height="140"/>
            <Button Content="Remove selected" Margin="0 5 0 10" HorizontalAlignment="Left"
                Command="{Binding RemoveCommand}"
                CommandParameter="{Binding SelectedItem, ElementName=AccountsList}"/>

            <TextBlock Text="New account name"/>
            <DockPanel Margin="0 2 0 12">
                <Button DockPanel.Dock="Right" Content="Add" Width="60" Margin="6 0 0 0"
                    Command="{Binding AddCommand}"
                    CommandParameter="{Binding Text, ElementName=NewNameBox}"/>
                <TextBox x:Name="NewNameBox"/>
            </DockPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK" Width="70" Command="{Binding OkCommand}"/>
                <Button Content="Cancel" Width="70" Margin="8 0 0 0"
                    IsCancel="True" Command="{Binding CancelCommand}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
