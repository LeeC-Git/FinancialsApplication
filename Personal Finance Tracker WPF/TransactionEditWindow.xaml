<Window x:Class="Personal_Finance_Tracker_WPF.TransactionEditWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Personal_Finance_Tracker_WPF"
        mc:Ignorable="d"
        Title="TransactionEditWindow" Height="450" Width="450">
    <Grid>
        <StackPanel Margin="15">
            <TextBlock Text="Transactions"/>
            <ListBox x:Name="TransactionsList" ItemsSource="{Binding WorkingTransactions}"
                 DisplayMemberPath="DisplayText" Height="140"/>
            <Button Content="Remove selected" Margin="0 5 0 10" HorizontalAlignment="Left"
                Command="{Binding RemoveCommand}"
                CommandParameter="{Binding SelectedItem, ElementName=TransactionsList}"/>

            <TextBlock Text="Description"/>
            <TextBox x:Name="DescriptionBox"
                 Text="{Binding SelectedItem.Description, ElementName=TransactionsList, Mode=OneWay}"/>
            <TextBlock Text="Amount" Margin="0 10 0 0"/>
            <TextBox x:Name="AmountBox"
                 Text="{Binding SelectedItem.Amount, ElementName=TransactionsList, Mode=OneWay}"/>

            <StackPanel Orientation="Horizontal" Margin="0 5 0 10">
                <Button Content="Add as new" Margin="0 0 5 0" Padding="8 2"
                    Command="{Binding AddCommand}"/>
                <Button Content="Update selected" Padding="8 2"
                    Command="{Binding UpdateCommand}"
                    CommandParameter="{Binding SelectedItem, ElementName=TransactionsList}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK" Width="70" Command="{Binding OkCommand}"/>
                <Button Content="Cancel" Width="70" Margin="5 0 0 0"
                    IsCancel="True" Command="{Binding CancelCommand}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
