<Window x:Class="Personal_Finance_Tracker_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Personal_Finance_Tracker_WPF"
        mc:Ignorable="d"
        Title="Personal Finance Tracker" Height="800" Width="600"
        ResizeMode="CanResize">
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#F5F5F5"
                Padding="15">
            <StackPanel>
                <TextBlock Text="ACCOUNTS"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0 0 0 10"
                           Foreground="#333">
                </TextBlock>

                <ListBox x:Name="AccountsListLeft"
                         SelectionChanged="AccountsListLeft_SelectionChanged"
                         BorderThickness="0">
                    <ListBoxItem Content="Checking"
                                 Padding="10 6"
                                 Margin="0 2" 
                                 Background="#FFFFFF"/>

                    <ListBoxItem Content="Savings"
                                 Padding="10 6"
                                 Margin="0 2"
                                 Background="#FFFFFF"/>

                    <ListBoxItem Content="Credit Card"
                                 Padding="10 6"
                                 Margin="0 2"
                                 Background="#FFFFFF"/>

                    <ListBoxItem Content="Investment"
                                 Padding="10 6"
                                 Margin="0 2"
                                 Background="#FFFFFF"/>
                </ListBox>
                
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Padding="20">
            <StackPanel>
                <TextBlock Text="Account: (none selected)"
                           x:Name="AccountNameText"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0 0 0 20"/>

                <TextBlock Text="Balance: "
                           x:Name="AccountBalanceText"
                           FontSize="16"
                           Margin="0 0 0 20"/>

                <StackPanel>
                    <TextBlock Text="Transactions"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0 0 0 10"/>

                    <ListBox x:Name="TransactionsList">
                        
                        <ListBoxItem Content="No transactions available"/>
                    </ListBox>
                    
                </StackPanel>

            </StackPanel>
            
        </Border>
        
    </Grid>
</Window>
